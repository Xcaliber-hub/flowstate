<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_light"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="15dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/group_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="STUDY CIRCLE"
            android:textColor="#F9F8FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:importantForAccessibility="no"
            android:background="@drawable/widget_accent_bar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/focus_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0 of 0"
            android:textColor="#B7A4F5"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focusing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="focusing"
            android:textColor="#D0CDDA"
            android:textSize="23sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatar_stack"
            android:layout_width="108dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/avatar_one"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/widget_avatar_frame"
                android:clipToOutline="true"
                android:contentDescription="First group member focusing"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/avatar_two"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="25dp"
                android:background="@drawable/widget_avatar_frame"
                android:clipToOutline="true"
                android:contentDescription="Second group member focusing"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/avatar_three"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="50dp"
                android:background="@drawable/widget_avatar_frame"
                android:clipToOutline="true"
                android:contentDescription="Another group member focusing"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/extra_badge"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/widget_badge"
                android:gravity="center"
                android:text="+1"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/member_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Member · 32m"
                android:textColor="#F9F8FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/member_two"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Member · 14m"
                android:textColor="#D0CDDA"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="No one is focusing right now"
                android:textColor="#D0CDDA"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/open_group"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:minWidth="120dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="OPEN GROUP"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
