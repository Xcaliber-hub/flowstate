<?xml version="1.0" encoding="utf-8"?>
<!-- 1.8.8 Group focus, 4x2: group, live count, up to three live members with subject, bar and minutes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/group_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="GROUP FOCUS"
                android:textColor="#D0CDDA"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.09" />
            <TextView
                android:id="@+id/group_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="JEE Grinders"
                android:textColor="#F9F8FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/live_pill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="8dp">
            <ImageView
                android:id="@+id/live_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_pill_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="11dp"
                android:paddingEnd="11dp">
                <ImageView
                    android:id="@+id/live_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/widget_shape_circle"
                    android:scaleType="fitXY"
                    android:tint="#62D0BB"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/live_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="3"
                    android:textColor="#F9F8FF"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />
                <TextView
                    android:id="@+id/live_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=" of 8 live"
                    android:textColor="#D0CDDA"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:id="@+id/member1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp">
        <ImageView
            android:id="@+id/avatar1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/member1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ananya"
                android:textColor="#F9F8FF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/member1_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Chemistry"
                android:textColor="#8CF9F8FF"
                android:textSize="10.5sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/member1_bar"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:layout_weight="1.6"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp" />
        <TextView
            android:id="@+id/member1_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="52m"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:minWidth="30dp"
            android:gravity="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/member2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp">
        <ImageView
            android:id="@+id/avatar2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/member2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ananya"
                android:textColor="#F9F8FF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/member2_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Chemistry"
                android:textColor="#8CF9F8FF"
                android:textSize="10.5sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/member2_bar"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:layout_weight="1.6"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp" />
        <TextView
            android:id="@+id/member2_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="52m"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:minWidth="30dp"
            android:gravity="end" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/member3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="7dp">
        <ImageView
            android:id="@+id/avatar3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView
                android:id="@+id/member3_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ananya"
                android:textColor="#F9F8FF"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/member3_subject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Chemistry"
                android:textColor="#8CF9F8FF"
                android:textSize="10.5sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/member3_bar"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            android:layout_weight="1.6"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp" />
        <TextView
            android:id="@+id/member3_minutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="52m"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:minWidth="30dp"
            android:gravity="end" />
    </LinearLayout>
    <TextView
        android:id="@+id/status_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="No one is focusing right now"
        android:textColor="#D0CDDA"
        android:textSize="12.5sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
