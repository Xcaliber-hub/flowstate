<?xml version="1.0" encoding="utf-8"?>
<!-- 1.8.8 Syllabus rings, 2x2: one ring per subject of the exam picked on the Syllabus tab, and what is up next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="SYLLABUS"
        android:textColor="#D0CDDA"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.09" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/ring1_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/ring1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_preview"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/ring1_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="62"
                    android:textColor="#F9F8FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </FrameLayout>
            <TextView
                android:id="@+id/ring1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Phy"
                android:textColor="#D0CDDA"
                android:textSize="10.5sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ring2_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/ring2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_preview"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/ring2_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="62"
                    android:textColor="#F9F8FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </FrameLayout>
            <TextView
                android:id="@+id/ring2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Phy"
                android:textColor="#D0CDDA"
                android:textSize="10.5sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ring3_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/ring3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_preview"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/ring3_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="62"
                    android:textColor="#F9F8FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </FrameLayout>
            <TextView
                android:id="@+id/ring3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Phy"
                android:textColor="#D0CDDA"
                android:textSize="10.5sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ring4_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/ring4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_preview"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/ring4_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="62"
                    android:textColor="#F9F8FF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
            </FrameLayout>
            <TextView
                android:id="@+id/ring4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Phy"
                android:textColor="#D0CDDA"
                android:textSize="10.5sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:id="@+id/up_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Up next · Rev 2 Thermodynamics"
        android:textColor="#D0CDDA"
        android:textSize="11.5sp" />
</LinearLayout>
