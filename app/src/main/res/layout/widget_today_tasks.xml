<?xml version="1.0" encoding="utf-8"?>
<!-- 1.8.8 Today's tasks, 2x2: up to four tasks with tick boxes and Add task. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="TASKS"
            android:textColor="#D0CDDA"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.09" />
        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="2 of 4"
            android:textColor="#8CF9F8FF"
            android:textSize="11.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/task1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:minHeight="22dp">
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp">
            <ImageView
                android:id="@+id/task1_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_check_outline_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/task1_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_check"
                android:scaleType="fitXY"
                android:tint="#B7A4F5"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/task1_check"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/widget_ic_check"
                android:scaleType="fitCenter"
                android:tint="#17131F"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/task1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Rev 1 · Integration"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/task2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:minHeight="22dp">
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp">
            <ImageView
                android:id="@+id/task2_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_check_outline_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/task2_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_check"
                android:scaleType="fitXY"
                android:tint="#B7A4F5"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/task2_check"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/widget_ic_check"
                android:scaleType="fitCenter"
                android:tint="#17131F"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/task2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Rev 1 · Integration"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/task3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:minHeight="22dp">
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp">
            <ImageView
                android:id="@+id/task3_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_check_outline_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/task3_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_check"
                android:scaleType="fitXY"
                android:tint="#B7A4F5"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/task3_check"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/widget_ic_check"
                android:scaleType="fitCenter"
                android:tint="#17131F"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/task3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Rev 1 · Integration"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/task4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:minHeight="22dp">
        <FrameLayout
            android:layout_width="18dp"
            android:layout_height="18dp">
            <ImageView
                android:id="@+id/task4_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_check_outline_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/task4_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_check"
                android:scaleType="fitXY"
                android:tint="#B7A4F5"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/task4_check"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/widget_ic_check"
                android:scaleType="fitCenter"
                android:tint="#17131F"
                android:importantForAccessibility="no"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:id="@+id/task4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Rev 1 · Integration"
            android:textColor="#F9F8FF"
            android:textSize="13sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Nothing due today"
        android:textColor="#D0CDDA"
        android:textSize="12.5sp"
        android:layout_marginTop="10dp"
        android:visibility="gone" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <FrameLayout
        android:id="@+id/add_task"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:contentDescription="Add task">
        <ImageView
            android:id="@+id/add_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_pill_dark"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/add_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="+  Add task"
            android:textColor="#F9F8FF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
