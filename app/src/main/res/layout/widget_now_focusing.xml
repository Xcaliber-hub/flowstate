<?xml version="1.0" encoding="utf-8"?>
<!-- 1.8.8 Now focusing, 4x1: round ring, status, subject, next break, live time, play/pause. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">
        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_ring_preview"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/ring_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="2/4"
            android:textColor="#F9F8FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_gravity="center" />
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_shape_circle"
                android:scaleType="fitXY"
                android:tint="#62D0BB"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="FOCUSING"
                android:textColor="#D0CDDA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.09"
                android:layout_marginStart="6dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Physics – Rotational motion"
            android:textColor="#F9F8FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp" />
        <TextView
            android:id="@+id/next_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Break at 5:41 pm"
            android:textColor="#8CF9F8FF"
            android:textSize="11.5sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
    <Chronometer
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        android:textColor="#F9F8FF"
        android:textSize="26sp" />
    <TextView
        android:id="@+id/time_static"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="16:12"
        android:textColor="#F9F8FF"
        android:textSize="26sp"
        android:fontFamily="sans-serif"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/btn_main"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:contentDescription="main"
        android:layout_marginStart="10dp">
        <ImageView
            android:id="@+id/btn_main_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_shape_circle"
            android:scaleType="fitXY"
            android:tint="#B7A4F5"
            android:importantForAccessibility="no" />
        <ImageView
            android:id="@+id/btn_main_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/widget_ic_pause"
            android:scaleType="fitCenter"
            android:tint="#17131F"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
