<?xml version="1.0" encoding="utf-8"?>
<!-- 1.8.8 Focus ring, 2x2: ring, subject, live time, round, stop / pause-resume / skip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_ring_preview"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="PHYSICS"
                android:textColor="#D0CDDA"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.09"
                android:maxWidth="96dp" />
            <Chronometer
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textColor="#F9F8FF"
                android:textSize="28sp"
                android:layout_marginTop="2dp" />
            <TextView
                android:id="@+id/time_static"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="16:12"
                android:textColor="#F9F8FF"
                android:textSize="28sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/round"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Round 2 of 4"
                android:textColor="#8CF9F8FF"
                android:textSize="10.5sp"
                android:layout_marginTop="3dp"
                android:maxWidth="100dp" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp">
        <FrameLayout
            android:id="@+id/btn_stop"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="stop">
            <ImageView
                android:id="@+id/btn_stop_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/btn_stop_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_ic_stop"
                android:scaleType="fitCenter"
                android:tint="#F9F8FF"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/btn_main"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="main"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <ImageView
                android:id="@+id/btn_main_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:scaleType="fitXY"
                android:tint="#B7A4F5"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/btn_main_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_ic_pause"
                android:scaleType="fitCenter"
                android:tint="#17131F"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/btn_skip"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="skip">
            <ImageView
                android:id="@+id/btn_skip_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/btn_skip_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_ic_skip"
                android:scaleType="fitCenter"
                android:tint="#F9F8FF"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
