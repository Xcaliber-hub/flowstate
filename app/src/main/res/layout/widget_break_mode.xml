<?xml version="1.0" encoding="utf-8"?>
<!-- 1.8.8 Break mode, 2x2: teal glass, break label, live countdown, a tip, Skip break and pause. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/status_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/widget_shape_circle"
            android:scaleType="fitXY"
            android:tint="#62D0BB"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="SHORT BREAK"
            android:textColor="#D0CDDA"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.09"
            android:layout_marginStart="7dp" />
    </LinearLayout>
    <Chronometer
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        android:textColor="#F9F8FF"
        android:textSize="44sp"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/time_static"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="03:48"
        android:textColor="#F9F8FF"
        android:textSize="44sp"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Stretch, sip water, look away"
        android:textColor="#D0CDDA"
        android:textSize="12.5sp"
        android:layout_marginTop="4dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:contentDescription="Skip break">
            <ImageView
                android:id="@+id/skip_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_pill_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/skip_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Skip break"
                android:textColor="#F9F8FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/btn_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="pause"
            android:layout_marginStart="10dp">
            <ImageView
                android:id="@+id/btn_pause_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_circle_dark"
                android:scaleType="fitXY"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/btn_pause_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_ic_pause"
                android:scaleType="fitCenter"
                android:tint="#F9F8FF"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
