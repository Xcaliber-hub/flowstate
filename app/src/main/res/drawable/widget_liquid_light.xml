<?xml version="1.0" encoding="utf-8"?>
<!-- 1.9.2 Liquid glass on a light wallpaper: clear, no colour tint. A faint neutral shade for depth,
     a top sheen, a bright lower lip and a white rim, 28dp corners. The launcher can't blur behind a widget. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="28dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#00FFFFFF" android:endColor="#1AFFFFFF" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" android:topLeftRadius="0dp" android:topRightRadius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#D9FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#0F000000" />
            <corners android:radius="27dp" />
        </shape>
    </item>
</layer-list>
